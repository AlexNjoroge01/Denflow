# ---------------------------------------------------------------------------
# DenFlow Plumbing & Water Solutions — environment variables
# Copy this file to .env.local and fill in the values. Never commit real keys.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used in metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://denflow.co.ke

# Resend — transactional email for quote requests.
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Where quote request notifications are delivered (Dennis's inbox).
CONTACT_TO_EMAIL=dennis@example.com

# Verified sender on your Resend domain, e.g. "DenFlow <quotes@denflow.co.ke>".
CONTACT_FROM_EMAIL=DenFlow <quotes@example.com>

# Cloudinary — static image delivery.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Only needed if you upload images from the app. Not required for static delivery.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp number in international format, digits only (no + or spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000

# Optional Google Analytics 4 measurement ID. Leave blank if unused.
NEXT_PUBLIC_GA_ID=
